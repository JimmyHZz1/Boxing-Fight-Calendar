{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimmyhzz1.github.io/Boxing-Fight-Calendar/data/games-database.schema.json",
  "title": "Games Calendar release database",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "region_default",
    "games"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "region_default": {
      "type": "string",
      "const": "GB"
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/game"
      }
    }
  },
  "$defs": {
    "game": {
      "type": "object",
      "required": [
        "id",
        "title",
        "platforms",
        "release_status",
        "release_type",
        "sources",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "igdb_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "developer": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "release_date_precision": {
          "enum": [
            "day",
            "month",
            "quarter",
            "year",
            "tba",
            "unknown"
          ]
        },
        "release_dates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "platform",
              "region",
              "date",
              "precision"
            ],
            "properties": {
              "platform": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "precision": {
                "enum": [
                  "day",
                  "month",
                  "quarter",
                  "year",
                  "tba",
                  "unknown"
                ]
              },
              "status": {
                "enum": [
                  "confirmed",
                  "estimated",
                  "delayed",
                  "cancelled",
                  "released",
                  "tba"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "region": {
          "type": "string",
          "default": "GB"
        },
        "release_status": {
          "enum": [
            "confirmed",
            "estimated",
            "tba",
            "delayed",
            "cancelled",
            "released"
          ]
        },
        "release_type": {
          "enum": [
            "full_release",
            "early_access",
            "expansion",
            "remaster",
            "remake",
            "edition",
            "other"
          ]
        },
        "artwork_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url",
              "source_type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "source_type": {
                "enum": [
                  "publisher",
                  "developer",
                  "platform_store",
                  "igdb",
                  "steamdb",
                  "secondary",
                  "manual"
                ]
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "needs_review",
            "conflicting",
            "unverified"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
