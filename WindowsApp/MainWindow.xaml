<Window x:Class="SportsGamesCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="The Hub"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource AppBackground}" Foreground="#F5F5F5"
        Icon="pack://application:,,,/app-icon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource ToolbarBackground}"
                BorderBrush="#343434" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button x:Name="MenuButton" Content="☰" FontSize="17" Padding="10,3"
                            Margin="0,0,10,0" ToolTip="Open app menu" Click="MenuButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock Text="THE HUB" Foreground="{StaticResource AccentGold}"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="28" Margin="3,0" Padding="0"
                            Background="#292929" Foreground="#F5F5F5" BorderBrush="#454545"
                            IsEnabled="False" Click="BackButton_Click" ToolTip="Back"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="28" Margin="3,0" Padding="0"
                            Background="#292929" Foreground="#F5F5F5" BorderBrush="#454545"
                            IsEnabled="False" Click="ForwardButton_Click" ToolTip="Forward"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="HomeButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="28" Margin="3,0" Padding="0"
                            Background="#292929" Foreground="#F5F5F5" BorderBrush="#454545"
                            Click="HomeButton_Click" ToolTip="Go to The Hub home"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <TextBlock x:Name="ConnectionLabel" Text="Connecting…" Foreground="#B8B8B8"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" Height="42" Padding="0" Margin="0"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MinimiseButton_Click" ToolTip="Minimise"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximiseButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" Height="42" Padding="0" Margin="0"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MaximiseButton_Click" ToolTip="Maximise or restore"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" Height="42" Padding="0" Margin="0"
                            Style="{StaticResource WindowCloseCaptionButton}"
                            Click="CloseButton_Click" ToolTip="Close to system tray"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="CalendarBrowser" Grid.Row="1" DefaultBackgroundColor="#151515" />
        <Border Grid.Row="2" Background="#202020" BorderBrush="#343434" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock Text="Close window to keep event alerts running in the system tray"
                           Foreground="#9B9B9B" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Text="Windows desktop" Foreground="#9B9B9B" FontSize="10"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>