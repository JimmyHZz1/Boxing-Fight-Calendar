<Application x:Class="SportsGamesCalendar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#151515" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#202020" />
        <SolidColorBrush x:Key="AccentGold" Color="#D6AD55" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#414141" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
